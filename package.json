{
  "name": "dsh-vscode-ok",
  "displayName": "dsh-vscode-ok",
  "description": "在 VS Code 里打开 DeepSeek Harness 官方界面：启动本地 dsh web 后端，解析启动 token，交给内置浏览器显示。与桌面客户端同一套前端，能力保持一致。",
  "version": "0.4.1",
  "publisher": "wukuang-818",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "agent",
    "chat",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:dsh.statusView",
    "onView:dsh.chatView",
    "onCommand:dsh.openInSidebar",
    "onCommand:dsh.openInEditor",
    "onCommand:dsh.openChat",
    "onCommand:dsh.focusChat",
    "onCommand:dsh.newChat",
    "onCommand:dsh.startBackend",
    "onCommand:dsh.restartBackend",
    "onCommand:dsh.stopBackend",
    "onCommand:dsh.showLogs",
    "onCommand:dsh.openInBrowser",
    "onCommand:dsh.copyUrl"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension launches a local agent runtime that reads files, runs commands and edits the workspace, so it needs a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "galleryBanner": {
    "color": "#1E2028",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wukuang-818/dsh-vscode-ok"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "dshSidebar",
          "title": "dsh-vscode-ok",
          "icon": "media/dsh.svg"
        }
      ]
    },
    "views": {
      "dshSidebar": [
        {
          "id": "dsh.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "dsh.openChat",
        "title": "打开界面",
        "category": "dsh-vscode-ok",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dsh.openInSidebar",
        "title": "在侧边栏打开",
        "category": "dsh-vscode-ok",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "dsh.openInEditor",
        "title": "在编辑器标签页打开",
        "category": "dsh-vscode-ok",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "dsh.focusChat",
        "title": "Focus Chat",
        "category": "dsh-vscode-ok",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dsh.newChat",
        "title": "New Chat",
        "category": "dsh-vscode-ok",
        "icon": "$(add)"
      },
      {
        "command": "dsh.startBackend",
        "title": "Start Backend",
        "category": "dsh-vscode-ok",
        "icon": "$(play)"
      },
      {
        "command": "dsh.restartBackend",
        "title": "Restart Backend",
        "category": "dsh-vscode-ok",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dsh.stopBackend",
        "title": "Stop Backend",
        "category": "dsh-vscode-ok",
        "icon": "$(stop)"
      },
      {
        "command": "dsh.showLogs",
        "title": "Show Logs",
        "category": "dsh-vscode-ok",
        "icon": "$(output)"
      },
      {
        "command": "dsh.openInBrowser",
        "title": "Open in External Browser",
        "category": "dsh-vscode-ok",
        "icon": "$(link-external)"
      },
      {
        "command": "dsh.copyUrl",
        "title": "Copy Access URL",
        "category": "dsh-vscode-ok",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dsh.restartBackend",
          "when": "view == dsh.chatView",
          "group": "navigation@1"
        },
        {
          "command": "dsh.showLogs",
          "when": "view == dsh.chatView",
          "group": "navigation@2"
        },
        {
          "command": "dsh.openInBrowser",
          "when": "view == dsh.chatView",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dsh.focusChat",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "configuration": {
      "title": "dsh-vscode-ok",
      "properties": {
        "dsh.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "`dsh.cmd` 的完整路径。留空自动查找桌面版安装目录（`DeepSeek Harness\\resources\\runtime\\cli\\bin\\dsh.cmd`）与 PATH。"
        },
        "dsh.executableArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "在 web 子命令之前追加的参数。留空使用内置默认值。"
        },
        "dsh.port": {
          "type": "number",
          "default": 3081,
          "minimum": 0,
          "maximum": 65535,
          "description": "后端监听端口。桌面版默认占用 3080，这里默认 3081 避免冲突。"
        },
        "dsh.autoPort": {
          "type": "boolean",
          "default": true,
          "description": "配置的端口被占用时，自动向后寻找空闲端口，而不是报错。"
        },
        "dsh.dshHome": {
          "type": "string",
          "default": "",
          "description": "覆盖 DSH_HOME。留空使用默认的 ~/.dsh，与桌面版共用会话与凭据。"
        },
        "dsh.startTimeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "等待后端打印访问地址的超时时间，单位毫秒。"
        },
        "dsh.placement": {
          "type": "string",
          "enum": [
            "sidebar",
            "editor"
          ],
          "default": "sidebar",
          "description": "“打开界面”默认落在哪里：sidebar 进侧边栏，可与 Copilot 并列；editor 用编辑器标签页，视野更宽。"
        },
        "dsh.useEditorTab": {
          "type": "boolean",
          "default": true,
          "description": "为 true 时用内置 Simple Browser 在编辑器标签页打开；为 false 时退回自建 webview 面板。"
        },
        "dsh.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "打开 Runtime 视图时自动启动或复用后端。"
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/wukuang-818/dsh-vscode-ok/issues"
  },
  "scripts": {
    "package": "npx @vscode/vsce package --no-dependencies"
  }
}
